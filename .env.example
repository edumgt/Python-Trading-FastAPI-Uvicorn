# ── Kafka ──────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── 공공데이터 API (한국은행 ECOS) ──────────────────
# 발급: https://ecos.bok.or.kr (오픈API 신청)
ECOS_API_KEY=

# ── PySpark ────────────────────────────────────────
SPARK_MASTER=local[*]

# ── Delta Lake / AWS S3 ─────────────────────────────
# 로컬 개발: 비워두면 ./data/delta 에 적재
# 운영: s3a://<bucket>/delta
DELTA_BASE_PATH=./data/delta
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
# MinIO 등 S3 호환 스토리지로 로컬 테스트 시에만 설정
S3_ENDPOINT_URL=
