# ── Kafka ──────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── 공공데이터 API (한국은행 ECOS) ──────────────────
# 발급: https://ecos.bok.or.kr (오픈API 신청)
ECOS_API_KEY=

# ── PySpark ────────────────────────────────────────
SPARK_MASTER=local[*]

# ── Delta Lake / AWS S3 ─────────────────────────────
# 로컬 개발: 비워두면 ./data/delta 에 적재
# 운영: s3a://<bucket>/delta
DELTA_BASE_PATH=./data/delta
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
# SageMaker real-time inference (선택): IAM role/instance profile 사용 권장
SAGEMAKER_ENDPOINT_NAME=
SAGEMAKER_PREDICT_TIMEOUT_SECONDS=10
# MinIO 등 S3 호환 스토리지로 로컬 테스트 시에만 설정
S3_ENDPOINT_URL=

# ── GCP Vertex AI Online Prediction (선택) ──────────
# 로컬에서는 `gcloud auth application-default login`을 사용하고,
# Cloud Run/GKE에서는 런타임 서비스 계정(Workload Identity)을 사용합니다.
# 서비스 계정 JSON 키를 저장소·이미지·.env에 넣지 마세요.
GCP_PROJECT_ID=
GCP_REGION=asia-northeast3
VERTEX_ENDPOINT_ID=
VERTEX_PREDICT_TIMEOUT_SECONDS=10
